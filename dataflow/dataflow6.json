{
	"name": "dataflow6",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"linkedService": {
						"referenceName": "lk_server_sample",
						"type": "LinkedServiceReference"
					},
					"name": "source1"
				},
				{
					"linkedService": {
						"referenceName": "lk_server_sample",
						"type": "LinkedServiceReference"
					},
					"name": "source2"
				}
			],
			"sinks": [
				{
					"linkedService": {
						"referenceName": "lk_server_sample",
						"type": "LinkedServiceReference"
					},
					"name": "sink1",
					"rejectedDataLinkedService": {
						"referenceName": "lk_storage_adls",
						"type": "LinkedServiceReference"
					}
				},
				{
					"linkedService": {
						"referenceName": "lk_server_sample",
						"type": "LinkedServiceReference"
					},
					"name": "sink2",
					"rejectedDataLinkedService": {
						"referenceName": "lk_storage_adls",
						"type": "LinkedServiceReference"
					}
				}
			],
			"transformations": [
				{
					"name": "pivot1"
				},
				{
					"name": "unpivot1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          SaleID as integer,",
				"          SaleDate as date,",
				"          Region as string,",
				"          Category as string,",
				"          Amount as decimal(10,2)",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table',",
				"     store: 'sqlserver',",
				"     schemaName: 'dbo',",
				"     tableName: 'SalesData',",
				"     isolationLevel: 'READ_UNCOMMITTED') ~> source1",
				"source(output(",
				"          id as integer,",
				"          dept as string,",
				"          india as integer,",
				"          usa as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table',",
				"     store: 'sqlserver',",
				"     schemaName: 'dbo',",
				"     tableName: 'job_roles',",
				"     isolationLevel: 'READ_UNCOMMITTED') ~> source2",
				"source1 pivot(groupBy(SaleID),",
				"     pivotBy(Region),",
				"     {} = count(SaleID),",
				"     columnNaming: '$N$V',",
				"     lateral: true) ~> pivot1",
				"source2 unpivot(output(",
				"          country as string,",
				"          emp_cnt as integer",
				"     ),",
				"     ungroupBy(id,",
				"          dept),",
				"     lateral: true,",
				"     ignoreNullPivots: false) ~> unpivot1",
				"pivot1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table',",
				"     store: 'sqlserver',",
				"     schemaName: 'dbo',",
				"     tableName: 'SalesData',",
				"     insertable: true,",
				"     updateable: false,",
				"     deletable: false,",
				"     upsertable: false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sink1",
				"unpivot1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table',",
				"     store: 'sqlserver',",
				"     schemaName: 'dbo',",
				"     tableName: 'job_roles',",
				"     insertable: true,",
				"     updateable: false,",
				"     deletable: false,",
				"     upsertable: false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sink2"
			]
		}
	}
}